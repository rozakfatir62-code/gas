/**
 * ============================================================
 * GASMANIA — ESP32 Firmware
 * Sensor : MQ-3 (Alcohol / BAC)
 * Display: OLED SSD1306 128x64 (I2C)
 * Backend: Cloudflare Worker (HTTP POST)
 * ============================================================
 *
 * Wiring:
 *   MQ-3  AOUT  → GPIO 34 (ADC1_CH6)
 *   MQ-3  VCC   → 5V
 *   MQ-3  GND   → GND
 *
 *   SSD1306 SDA → GPIO 21
 *   SSD1306 SCL → GPIO 22
 *   SSD1306 VCC → 3.3V
 *   SSD1306 GND → GND
 */

#include <WiFi.h>
#include <HTTPClient.h>
#include <ArduinoJson.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <EEPROM.h>

// ============================================================
// KONFIGURASI — Ganti sesuai milik Anda
// ============================================================
const char* WIFI_SSID     = "Ftr";
const char* WIFI_PASSWORD = "12345678";

// URL endpoint Cloudflare Worker Anda
const char* WORKER_URL    = "https://gas-three-rust.vercel.app/api/sensor";

// ============================================================
// KONFIGURASI HARDWARE
// ============================================================
#define MQ3_PIN         34       // Pin ADC untuk sensor MQ-3
#define OLED_WIDTH      128
#define OLED_HEIGHT     64
#define OLED_RESET      -1       // Reset pin (tidak dipakai, pakai -1)
#define OLED_I2C_ADDR   0x3C    // Alamat I2C SSD1306 (biasanya 0x3C atau 0x3D)

// ============================================================
// KONFIGURASI SENSOR & PENGIRIMAN
// ============================================================
#define ADC_MAX         4095     // Resolusi ADC ESP32 (12-bit)
#define VCC             3.3f     // Tegangan referensi ADC
#define RL_VALUE        10.0f    // Nilai resistor Load (kΩ) pada modul MQ-3
#define RO_CLEAN_AIR    60.0f    // Nilai R0 di udara bersih (perlu kalibrasi!)

// Interval pengiriman data ke server (ms)
#define SEND_INTERVAL_MS  2000  // Kirim setiap 2 detik

// ============================================================
// KONFIGURASI KALIBRASI & EEPROM
// ============================================================
#define EEPROM_SIZE         16
#define EEPROM_ADDR_FACTOR  0     // Alamat EEPROM untuk faktor koreksi (float, 4 byte)
#define EEPROM_ADDR_VALID   4     // Alamat flag validasi (1 byte) — nilai 0xAB = sudah dikalibrasi
#define EEPROM_VALID_FLAG   0xAB
#define KALIBASI_TRIGGER    'K'   // Ketik 'K' di Serial Monitor untuk mulai kalibrasi

// ============================================================
// INISIALISASI OBJEK
// ============================================================
Adafruit_SSD1306 display(OLED_WIDTH, OLED_HEIGHT, &Wire, OLED_RESET);

// Variabel global
float g_bacValue        = 0.0f;
float g_rawAnalog       = 0;
String g_statusText     = "Inisialisasi";
String g_wifiStatus     = "Menghubungkan...";
bool g_isConnected      = false;
unsigned long g_lastSendTime = 0;
int g_sendCount         = 0;
bool g_lastSendOk       = false;
float g_faktorKoreksi   = 1.0f;   // Default: tidak ada koreksi
bool g_sudahKalibrasi   = false;


// ============================================================
// FUNGSI: Baca & Simpan Faktor Koreksi dari EEPROM
// ============================================================
void loadFaktorKoreksi() {
  EEPROM.begin(EEPROM_SIZE);
  uint8_t flag = EEPROM.read(EEPROM_ADDR_VALID);

  if (flag == EEPROM_VALID_FLAG) {
    EEPROM.get(EEPROM_ADDR_FACTOR, g_faktorKoreksi);
    g_sudahKalibrasi = true;
    Serial.printf("[EEPROM] ✅ Faktor koreksi ditemukan: %.4f\n", g_faktorKoreksi);
  } else {
    g_faktorKoreksi = 1.0f;
    g_sudahKalibrasi = false;
    Serial.println("[EEPROM] ⚠️  Belum dikalibrasi. Pakai faktor default = 1.0");
  }
}

void saveFaktorKoreksi(float faktor) {
  EEPROM.begin(EEPROM_SIZE);
  EEPROM.put(EEPROM_ADDR_FACTOR, faktor);
  EEPROM.write(EEPROM_ADDR_VALID, EEPROM_VALID_FLAG);
  EEPROM.commit();
  Serial.printf("[EEPROM] 💾 Faktor koreksi disimpan: %.4f\n", faktor);
}


// ============================================================
// FUNGSI: Proses Kalibrasi via Serial Monitor
// ============================================================
void prosesKalibrasi() {
  Serial.println("\n============================================");
  Serial.println("       MODE KALIBRASI SENSOR MQ-3");
  Serial.println("============================================");
  Serial.println("1. Pastikan sensor sudah warm-up minimal 5 menit");
  Serial.println("2. Tiup napas ke sensor DAN alat pembanding");
  Serial.println("3. Tunggu nilai sensor stabil di bawah ini:");
  Serial.println("--------------------------------------------");

  // Tampilkan nilai sensor live selama 10 detik
  Serial.println("Nilai sensor saat ini (10 detik):");
  for (int i = 0; i < 20; i++) {
    readAndUpdateSensor();
    Serial.printf("  → BAC sensor: %.2f%%\n", g_bacValue * 10.0f);

    // Tampilkan di OLED mode kalibrasi
    display.clearDisplay();
    display.setTextSize(1);
    display.setCursor(0, 0);
    display.println("== KALIBRASI MODE ==");
    display.setCursor(0, 16);
    display.println("Tiup sensor & alat");
    display.setCursor(0, 28);
    display.println("pembanding sekarang!");
    display.setCursor(0, 44);
    display.print("Sensor: ");
    char buf[12];
    sprintf(buf, "%.2f%%", g_bacValue * 10.0f);
    display.println(buf);
    display.display();

    delay(500);
  }

  Serial.println("--------------------------------------------");
  Serial.println("Ketik nilai dari ALAT PEMBANDING (contoh: 0.05)");
  Serial.println("lalu tekan Enter:");

  // Tunggu input dari Serial Monitor
  String inputStr = "";
  unsigned long startWait = millis();

  while (millis() - startWait < 30000) { // Tunggu max 30 detik
    if (Serial.available()) {
      char c = Serial.read();
      if (c == '\n' || c == '\r') {
        if (inputStr.length() > 0) break;
      } else {
        inputStr += c;
      }
    }
  }

  if (inputStr.length() == 0) {
    Serial.println("[Kalibrasi] ❌ Timeout. Kalibrasi dibatalkan.");
    return;
  }

  float nilaiPembanding = inputStr.toFloat();

  if (nilaiPembanding <= 0.0f || nilaiPembanding > 0.40f) {
    Serial.printf("[Kalibrasi] ❌ Nilai tidak valid: %.3f. Harus antara 0.001 – 0.40\n", nilaiPembanding);
    return;
  }

  // Baca nilai sensor saat ini (rata-rata 5 kali)
  float totalBac = 0;
  for (int i = 0; i < 5; i++) {
    readAndUpdateSensor();
    totalBac += g_bacValue;
    delay(200);
  }
  float nilaiSensor = totalBac / 5.0f;

  if (nilaiSensor <= 0.0f) {
    Serial.println("[Kalibrasi] ❌ Nilai sensor 0. Pastikan sensor terkena gas saat kalibrasi.");
    return;
  }

  // Hitung faktor koreksi
  float faktorBaru = nilaiPembanding / nilaiSensor;

  Serial.println("\n============================================");
  Serial.printf("  Nilai alat pembanding : %.3f%%\n", nilaiPembanding * 10.0f);
  Serial.printf("  Nilai sensor (raw)     : %.3f%%\n", nilaiSensor * 10.0f);
  Serial.printf("  Faktor koreksi baru    : %.4f\n", faktorBaru);
  Serial.println("============================================");

  // Simpan ke EEPROM
  saveFaktorKoreksi(faktorBaru);
  g_faktorKoreksi   = faktorBaru;
  g_sudahKalibrasi  = true;

  Serial.println("[Kalibrasi] ✅ Kalibrasi berhasil! Faktor disimpan permanen.");
  Serial.println("[Kalibrasi] ESP32 akan lanjut monitoring dengan faktor baru.\n");

  // Tampilkan hasil di OLED
  display.clearDisplay();
  display.setTextSize(1);
  display.setCursor(0, 0);
  display.println("KALIBRASI BERHASIL!");
  display.setCursor(0, 16);
  display.print("Faktor: ");
  char buf[16];
  sprintf(buf, "%.4f", faktorBaru);
  display.println(buf);
  display.setCursor(0, 32);
  display.print("Ref  : ");
  sprintf(buf, "%.2f%%", nilaiPembanding * 10.0f);
  display.println(buf);
  display.setCursor(0, 44);
  display.print("Sensor: ");
  sprintf(buf, "%.2f%%", nilaiSensor * 10.0f);
  display.println(buf);
  display.display();
  delay(3000);
}


// ============================================================
// FUNGSI SETUP
// ============================================================
void setup() {
  Serial.begin(115200);
  Serial.println("\n\n==============================");
  Serial.println("  GASMANIA ESP32 Firmware v1.0");
  Serial.println("==============================");

  // --- Load faktor kalibrasi dari EEPROM ---
  loadFaktorKoreksi();

  // --- Inisialisasi OLED ---
  initDisplay();

  // --- Tampilkan splash screen ---
  showSplash();

  // --- Konfigurasi ADC ---
  analogReadResolution(12);        // 12-bit: 0–4095
  analogSetAttenuation(ADC_11db);  // Range: 0–3.3V

  // --- Hubungkan ke WiFi ---
  connectWiFi();

  // --- Baca pertama kali ---
  readAndUpdateSensor();

  Serial.println("[Setup] Siap! Mulai monitoring...");
  Serial.println("[Setup] Ketik 'K' + Enter di Serial Monitor untuk memulai kalibrasi.\n");
}


// ============================================================
// LOOP UTAMA
// ============================================================
void loop() {
  unsigned long now = millis();

  // Cek input Serial — jika ketik 'K' maka mulai kalibrasi
  if (Serial.available()) {
    char input = Serial.read();
    if (input == KALIBASI_TRIGGER || input == 'k') {
      prosesKalibrasi();
    }
  }

  // 1. Selalu baca sensor setiap loop
  readAndUpdateSensor();

  // 2. Update tampilan OLED
  updateDisplay();

  // 3. Kirim ke server setiap SEND_INTERVAL_MS
  if (now - g_lastSendTime >= SEND_INTERVAL_MS) {
    g_lastSendTime = now;

    if (WiFi.status() == WL_CONNECTED) {
      g_isConnected = true;
      sendToWorker(g_bacValue, (int)g_rawAnalog);
    } else {
      g_isConnected = false;
      Serial.println("[WiFi] Koneksi terputus. Mencoba reconnect...");
      WiFi.reconnect();
    }
  }

  delay(500); // Baca sensor setiap 0.5 detik
}


// ============================================================
// FUNGSI: Baca Sensor MQ-3 & Hitung BAC
// ============================================================
void readAndUpdateSensor() {
  // Ambil rata-rata 10 sample untuk stabilitas
  long sum = 0;
  for (int i = 0; i < 10; i++) {
    sum += analogRead(MQ3_PIN);
    delay(5);
  }
  float rawAvg = sum / 10.0f;
  g_rawAnalog = rawAvg;

  // Konversi ADC ke tegangan
  float voltage = (rawAvg / ADC_MAX) * VCC;

  // Hitung Rs (sensor resistance)
  // Rs = RL * (VCC - Vout) / Vout
  float rs = 0.0f;
  if (voltage > 0.01f) {
    rs = RL_VALUE * (VCC - voltage) / voltage;
  } else {
    rs = RL_VALUE * 1000; // Hindari div by zero
  }

  // Rasio Rs/R0 — makin rendah = makin banyak alkohol
  float ratio = rs / RO_CLEAN_AIR;

  // Kurva karakteristik MQ-3 (pendekatan log-linear)
  float a = 0.4f;
  float b = -1.431f;
  float bac = a * pow(ratio, b);

  // Terapkan faktor koreksi dari kalibrasi
  bac = bac * g_faktorKoreksi;

  // Clamp nilai BAC ke range logis 0.00 – 0.40%
  bac = constrain(bac, 0.0f, 0.40f);
  g_bacValue = bac;

  // Tentukan status
  if (bac >= 0.08f) {
    g_statusText = "BAHAYA";
  } else if (bac >= 0.05f) {
    g_statusText = "WASPADA";
  } else {
    g_statusText = "AMAN";
  }

  Serial.printf("[Sensor] Raw ADC: %.0f | Voltage: %.3fV | Rs: %.2fkΩ | Ratio: %.4f | BAC: %.2f%% | Status: %s\n",
                rawAvg, voltage, rs, ratio, bac * 10.0f, g_statusText.c_str());
}


// ============================================================
// FUNGSI: Kirim Data ke Cloudflare Worker
// ============================================================
void sendToWorker(float bacValue, int rawValue) {
  Serial.printf("[HTTP] Mengirim data → BAC: %.2f%%\n", bacValue * 10.0f);

  HTTPClient http;
  http.begin(WORKER_URL);
  http.addHeader("Content-Type", "application/json");
  http.setTimeout(8000); // Timeout 8 detik

  // Buat payload JSON
  // Format yang diterima Worker: { "bac": 0.05 }
  StaticJsonDocument<128> doc;
  doc["bac"]       = round(bacValue * 10000.0f) / 1000.0f; // dikali 10, 3 desimal
  doc["raw"]       = rawValue;
  doc["status"]    = g_statusText;

  String payload;
  serializeJson(doc, payload);
  Serial.printf("[HTTP] Payload: %s\n", payload.c_str());

  int httpCode = http.POST(payload);

  if (httpCode == HTTP_CODE_OK || httpCode == 200) {
    String response = http.getString();
    Serial.printf("[HTTP] ✅ Berhasil! Code: %d | Response: %s\n", httpCode, response.c_str());
    g_lastSendOk = true;
    g_sendCount++;
  } else if (httpCode > 0) {
    Serial.printf("[HTTP] ⚠️ Server Error. Code: %d\n", httpCode);
    g_lastSendOk = false;
  } else {
    Serial.printf("[HTTP] ❌ Gagal koneksi ke server. Error: %s\n", http.errorToString(httpCode).c_str());
    g_lastSendOk = false;
  }

  http.end();
}


// ============================================================
// FUNGSI: Inisialisasi Display OLED
// ============================================================
void initDisplay() {
  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_I2C_ADDR)) {
    Serial.println("[OLED] ❌ GAGAL! Periksa wiring I2C.");
    return;
  }
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  Serial.println("[OLED] ✅ SSD1306 berhasil diinisialisasi.");
}


// ============================================================
// FUNGSI: Splash Screen
// ============================================================
void showSplash() {
  display.clearDisplay();
  display.setTextSize(2);
  display.setCursor(15, 8);
  display.println("GASMANIA");
  display.setTextSize(1);
  display.setCursor(20, 32);
  display.println("IoT Gas Monitor");
  display.setCursor(28, 46);
  display.println("Initializing...");
  display.display();
  delay(2500);
}


// ============================================================
// FUNGSI: Update Tampilan OLED
// ============================================================
void updateDisplay() {
  display.clearDisplay();

  // === BARIS 1: Judul ===
  display.setTextSize(1);
  display.setCursor(0, 0);

  // Tampilkan tanda sudah kalibrasi atau belum
  if (g_sudahKalibrasi) {
    display.println("-- GASMANIA [CAL] --");
  } else {
    display.println("-- GASMANIA MONITOR --");
  }

  // === BARIS 2-3: Nilai BAC Besar ===
  display.setTextSize(2);
  display.setCursor(10, 14);
  char bacStr[12];
  sprintf(bacStr, "%.2f%%", g_bacValue * 10.0f);
  display.print(bacStr);
  display.setTextSize(1);
  display.setCursor(95, 20);
  display.print("BAC");

  // === BARIS 4: Status ===
  display.setTextSize(1);
  display.setCursor(0, 34);
  display.print("Status : ");

  // Invert warna untuk status BAHAYA
  if (g_statusText == "BAHAYA") {
    display.fillRect(50, 32, 78, 10, SSD1306_WHITE);
    display.setTextColor(SSD1306_BLACK);
    display.setCursor(52, 34);
    display.print(g_statusText);
    display.setTextColor(SSD1306_WHITE);
  } else {
    display.print(g_statusText);
  }

  // === BARIS 5: Raw ADC ===
  display.setCursor(0, 46);
  display.printf("Raw ADC: %.0f", g_rawAnalog);

  // === BARIS 6: WiFi & Status Kirim ===
  display.setCursor(0, 56);
  if (g_isConnected) {
    if (g_lastSendOk) {
      display.printf("WiFi:OK  Sent:%d", g_sendCount);
    } else {
      display.print("WiFi:OK  Send:ERR");
    }
  } else {
    display.print("WiFi: DISCONNECTED");
  }

  display.display();
}


// ============================================================
// FUNGSI: Koneksi WiFi
// ============================================================
void connectWiFi() {
  Serial.printf("[WiFi] Menghubungkan ke: %s\n", WIFI_SSID);

  display.clearDisplay();
  display.setTextSize(1);
  display.setCursor(0, 0);
  display.println("Connecting WiFi...");
  display.setCursor(0, 16);
  display.println(WIFI_SSID);
  display.display();

  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  WiFi.setAutoReconnect(true);

  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 30) {
    delay(500);
    Serial.print(".");
    attempts++;

    // Animasi titik di OLED
    display.setCursor(attempts * 4, 36);
    display.print(".");
    display.display();
  }

  if (WiFi.status() == WL_CONNECTED) {
    g_isConnected = true;
    Serial.printf("\n[WiFi] ✅ Terhubung! IP: %s\n", WiFi.localIP().toString().c_str());

    display.clearDisplay();
    display.setCursor(0, 0);
    display.println("WiFi Connected!");
    display.setCursor(0, 16);
    display.print("IP: ");
    display.println(WiFi.localIP().toString());
    display.display();
    delay(2000);
  } else {
    g_isConnected = false;
    Serial.println("\n[WiFi] ❌ Gagal terhubung. Jalankan tanpa WiFi.");

    display.clearDisplay();
    display.setCursor(0, 0);
    display.println("WiFi FAILED!");
    display.setCursor(0, 16);
    display.println("Mode Offline");
    display.display();
    delay(2000);
  }
}
