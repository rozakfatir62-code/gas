/**
 * ============================================================
 * GASMANIA — ESP32 Firmware
 * Sensor : MQ-3 (MQUnifiedsensor)
 * Display: OLED SSD1306 128x64 (I2C)
 * Backend: HTTP POST ke Vercel API
 * ============================================================
 *
 * Wiring:
 *   MQ-3  AOUT  → GPIO 34 (ADC1_CH6)
 *   MQ-3  VCC   → 5V
 *   MQ-3  GND   → GND
 *
 *   SSD1306 SDA → GPIO 21
 *   SSD1306 SCL → GPIO 22
 *   SSD1306 VCC → 3.3V
 *   SSD1306 GND → GND
 */

#include <MQUnifiedsensor.h>
#include <WiFi.h>
#include <HTTPClient.h>
#include <ArduinoJson.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// ============================================================
// KONFIGURASI WiFi & Server
// ============================================================
const char* WIFI_SSID = "Ftr";
const char* WIFI_PASSWORD = "12345678";
const char* WORKER_URL = "https://gas-swart.vercel.app/api/sensor";

// ============================================================
// KONFIGURASI OLED
// ============================================================
#define OLED_WIDTH 128
#define OLED_HEIGHT 64
#define OLED_RESET -1
#define OLED_I2C_ADDR 0x3C

// ============================================================
// KONFIGURASI SENSOR — SAMA PERSIS DENGAN KODE PERTAMA
// ============================================================
#define BOARD "ESP-32"
#define PIN_ANALOG 34
#define TYPE "MQ-3"
#define VOLTAGE_RES 3.3f
#define ADC_RESOLUTION 12
#define R0_VALUE 13.6771f
#define NUM_SAMPLES 20

// ============================================================
// INISIALISASI OBJEK
// ============================================================
MQUnifiedsensor MQ3(BOARD, VOLTAGE_RES, ADC_RESOLUTION, PIN_ANALOG, TYPE);
Adafruit_SSD1306 display(OLED_WIDTH, OLED_HEIGHT, &Wire, OLED_RESET);

// ============================================================
// VARIABEL — SAMA PERSIS DENGAN KODE PERTAMA
// ============================================================
float ppm_buffer[NUM_SAMPLES];
int buf_index = 0;
bool buf_full = false;
int counter = 0;

// Variabel tambahan untuk OLED & WiFi
bool g_isConnected = false;
int g_sendCount = 0;
bool g_lastSendOk = false;

// ============================================================
// VARIABEL UNTUK MODE HOLD (kunci nilai saat stabil)
// ============================================================
#define HOLD_DURATION_MS 3000  // 3 detik nilai stabil ditahan

bool g_isHolding = false;       // true = sedang menahan nilai stabil
unsigned long g_holdStart = 0;  // waktu mulai hold

// Nilai yang dikunci selama hold
float g_heldAdc = 0;
float g_heldPpm = 0;
String g_heldBac = "0.00 mg/L";


// ============================================================
// FUNGSI DARI KODE PERTAMA — TIDAK DIUBAH
// ============================================================
float getAveragePPM() {
  int count = buf_full ? NUM_SAMPLES : buf_index;
  if (count == 0) return 0;
  float sum = 0;
  for (int i = 0; i < count; i++) sum += ppm_buffer[i];
  return sum / count;
}

float getAverageADC() {
  long sum = 0;
  for (int i = 0; i < NUM_SAMPLES; i++) {
    sum += analogRead(PIN_ANALOG);
    delay(5);
  }
  return (float)sum / NUM_SAMPLES;
}

String getBACFromPPM(float ppm) {
  if (ppm >= 0.0000f && ppm <= 0.1000f) {
    return "0.00 mg/L";
  } else if (ppm > 0.1000f && ppm <= 0.2070f) {
    return "0.07 mg/L";
  } else if (ppm > 0.2100f && ppm <= 0.2378f) {
    return "0.08 mg/L";
  } else if (ppm > 0.2378f && ppm <= 0.3300f) {
    return "0.09 mg/L";
  } else if (ppm > 0.3300f && ppm <= 0.5380f) {
    return "0.10 mg/L";
  } else if (ppm > 0.5380f && ppm <= 0.6795f) {
    return "0.11 mg/L";
  } else if (ppm > 0.6795f && ppm <= 0.7980f) {
    return "0.12 mg/L";
  } else if (ppm >= 0.7980f && ppm <= 0.9875f) {
    return "0.13 mg/L";
  } else if (ppm >= 0.9875f && ppm <= 1.3875f) {
    return "0.14 mg/L";
  } else if (ppm > 1.3875f) {
    return "0.15 mg/L";
  } else {
    return "0.00 mg/L";
  }
}

void resetSemua() {
  buf_full = false;
  buf_index = 0;
  counter = 0;
  for (int i = 0; i < NUM_SAMPLES; i++) ppm_buffer[i] = 0;
  Serial.println("-----|---------|---------|----------------------|--------");
  Serial.println("[RESET] Siap baca ulang...\n");
}


// ============================================================
// FUNGSI TAMBAHAN: OLED
// ============================================================
void initDisplay() {
  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_I2C_ADDR)) {
    Serial.println("[OLED] ❌ GAGAL! Periksa wiring I2C.");
    return;
  }
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  Serial.println("[OLED] ✅ SSD1306 berhasil diinisialisasi.");
}

void showSplash() {
  display.clearDisplay();
  display.setTextSize(2);
  display.setCursor(15, 8);
  display.println("GASMANIA");
  display.setTextSize(1);
  display.setCursor(20, 32);
  display.println("IoT Gas Monitor");
  display.setCursor(28, 46);
  display.println("Initializing...");
  display.display();
  delay(2500);
}

void updateDisplay(float adc_avg, float ppm_avg, String bac, bool stabil) {
  display.clearDisplay();

  // Baris 1: Judul
  display.setTextSize(1);
  display.setCursor(0, 0);
  display.println("--- GASMANIA MQ-3 ---");

  // Baris 2: ADC
  display.setCursor(0, 12);
  display.printf("ADC : %.1f", adc_avg);

  // Baris 3: PPM
  display.setCursor(0, 22);
  display.printf("PPM : %.4f", ppm_avg);

  // Baris 4: BAC
  display.setCursor(0, 32);
  display.print("BAC : ");
  display.print(bac);

  // Baris 5: Stabil
  display.setCursor(0, 44);
  if (stabil) {
    display.fillRect(0, 42, 128, 11, SSD1306_WHITE);
    display.setTextColor(SSD1306_BLACK);
    display.setCursor(2, 44);
    display.print("Status: STABIL ✓");
    display.setTextColor(SSD1306_WHITE);
  } else {
    display.print("Status: menunggu...");
  }

  // Baris 6: WiFi & kirim
  display.setCursor(0, 56);
  if (g_isConnected) {
    if (g_lastSendOk) {
      display.printf("WiFi:OK  Sent:%d", g_sendCount);
    } else {
      display.print("WiFi:OK  Send:ERR");
    }
  } else {
    display.print("WiFi: DISCONNECTED");
  }

  display.display();
}


// ============================================================
// FUNGSI TAMBAHAN: WiFi
// ============================================================
void connectWiFi() {
  Serial.printf("[WiFi] Menghubungkan ke: %s\n", WIFI_SSID);

  display.clearDisplay();
  display.setTextSize(1);
  display.setCursor(0, 0);
  display.println("Connecting WiFi...");
  display.setCursor(0, 16);
  display.println(WIFI_SSID);
  display.display();

  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  WiFi.setAutoReconnect(true);

  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 30) {
    delay(500);
    Serial.print(".");
    attempts++;
    display.setCursor(attempts * 4, 36);
    display.print(".");
    display.display();
  }

  if (WiFi.status() == WL_CONNECTED) {
    g_isConnected = true;
    Serial.printf("\n[WiFi] ✅ Terhubung! IP: %s\n", WiFi.localIP().toString().c_str());
    display.clearDisplay();
    display.setCursor(0, 0);
    display.println("WiFi Connected!");
    display.setCursor(0, 16);
    display.print("IP: ");
    display.println(WiFi.localIP().toString());
    display.display();
    delay(2000);
  } else {
    g_isConnected = false;
    Serial.println("\n[WiFi] ❌ Gagal terhubung. Mode Offline.");
    display.clearDisplay();
    display.setCursor(0, 0);
    display.println("WiFi FAILED!");
    display.setCursor(0, 16);
    display.println("Mode Offline");
    display.display();
    delay(2000);
  }
}


// ============================================================
// FUNGSI TAMBAHAN: Kirim ke Server
// ============================================================
void sendToServer(float adc_avg, float ppm_avg, String bac, bool stabil) {
  if (WiFi.status() != WL_CONNECTED) {
    g_isConnected = false;
    Serial.println("[WiFi] Koneksi terputus. Mencoba reconnect...");
    WiFi.reconnect();
    return;
  }
  g_isConnected = true;

  HTTPClient http;
  http.begin(WORKER_URL);
  http.addHeader("Content-Type", "application/json");
  http.setTimeout(8000);

  StaticJsonDocument<200> doc;
  doc["adc"] = adc_avg;
  doc["ppm"] = ppm_avg;
  doc["bac"] = bac;
  doc["stabil"] = stabil;
  doc["count"] = counter;

  String payload;
  serializeJson(doc, payload);
  Serial.printf("[HTTP] Payload: %s\n", payload.c_str());

  int httpCode = http.POST(payload);
  if (httpCode == HTTP_CODE_OK || httpCode == 200) {
    Serial.printf("[HTTP] ✅ Berhasil! Code: %d\n", httpCode);
    g_lastSendOk = true;
    g_sendCount++;
  } else if (httpCode > 0) {
    Serial.printf("[HTTP] ⚠️ Server Error. Code: %d\n", httpCode);
    g_lastSendOk = false;
  } else {
    Serial.printf("[HTTP] ❌ Gagal. Error: %s\n", http.errorToString(httpCode).c_str());
    g_lastSendOk = false;
  }
  http.end();
}


// ============================================================
// SETUP — SAMA DENGAN KODE PERTAMA + inisialisasi OLED & WiFi
// ============================================================
void setup() {
  Serial.begin(115200);
  delay(1000);

  // Inisialisasi OLED
  initDisplay();
  showSplash();

  // MQUnifiedsensor — sama persis kode pertama
  MQ3.setRegressionMethod(1);
  MQ3.setA(0.3934);
  MQ3.setB(-1.504);
  MQ3.init();
  MQ3.setR0(R0_VALUE);

  // Warm-up — sama persis kode pertama
  Serial.println("[WARM-UP] 30 detik...");
  display.clearDisplay();
  display.setTextSize(1);
  display.setCursor(0, 0);
  display.println("WARM-UP SENSOR MQ-3");
  display.display();

  for (int i = 30; i > 0; i--) {
    Serial.print(i);
    Serial.print(" ");
    if (i % 10 == 0) Serial.println();
    display.fillRect(0, 16, 128, 10, SSD1306_BLACK);
    display.setCursor(0, 16);
    display.printf("Sisa: %d detik   ", i);
    display.display();
    delay(1000);
  }
  Serial.println("\n[SIAP] Mulai catat!\n");

  Serial.println("No   | ADC_avg | PPM_avg | BAC                  | Stabil?");
  Serial.println("-----|---------|---------|----------------------|--------");

  // Hubungkan WiFi
  connectWiFi();
}


// ============================================================
// LOOP — MODE NORMAL + MODE HOLD (kunci nilai 3 detik saat stabil)
// ============================================================
void loop() {
  static unsigned long lastRead = 0;
  static float ppm_prev = -1;

  if (millis() - lastRead < 500) return;
  lastRead = millis();

  // ------------------------------------------------------------
  // MODE HOLD: nilai sudah dikunci, tampilkan & kirim nilai yang
  // sama terus tanpa membaca/menghitung ulang sensor, sampai
  // durasi HOLD_DURATION_MS habis.
  // ------------------------------------------------------------
  if (g_isHolding) {
    // Tampilkan nilai yang dikunci (tidak berubah)
    updateDisplay(g_heldAdc, g_heldPpm, g_heldBac, true);

    // Kirim ulang nilai yang sama ke server tiap 500ms
    sendToServer(g_heldAdc, g_heldPpm, g_heldBac, true);

    // Cek apakah durasi hold sudah selesai
    if (millis() - g_holdStart >= HOLD_DURATION_MS) {
      Serial.print(">>> HOLD SELESAI. Nilai terakhir: ");
      Serial.println(g_heldBac);

      g_isHolding = false;
      ppm_prev = -1;
      resetSemua();  // reset buffer & tampilan kembali ke 0
    }
    return;  // selama hold, skip pembacaan sensor di bawah
  }

  // ------------------------------------------------------------
  // MODE NORMAL: baca sensor seperti biasa
  // ------------------------------------------------------------

  // Update PPM buffer — sama persis kode pertama
  MQ3.update();
  float ppm_now = MQ3.readSensor();
  ppm_buffer[buf_index] = ppm_now;
  buf_index = (buf_index + 1) % NUM_SAMPLES;
  if (buf_index == 0) buf_full = true;

  // Tampilkan setiap buffer penuh — sama persis kode pertama
  int count = buf_full ? NUM_SAMPLES : buf_index;
  if (count < NUM_SAMPLES) return;

  float ppm_avg = getAveragePPM();
  float adc_avg = getAverageADC();
  String bac = getBACFromPPM(ppm_avg);

  // Deteksi stabil — toleransi diperbesar agar lebih realistis terhadap noise sensor
  bool stabil = (ppm_prev >= 0) && (abs(ppm_avg - ppm_prev) < 0.08f);
  ppm_prev = ppm_avg;

  counter++;
  Serial.print(counter);
  Serial.print("    | ");
  Serial.print(adc_avg, 1);
  Serial.print("   | ");
  Serial.print(ppm_avg, 2);
  Serial.print("  | ");
  Serial.print(bac);
  Serial.print(" | ");
  Serial.println(stabil ? "STABIL ✓" : "menunggu...");

  // Tampilkan ke OLED
  updateDisplay(adc_avg, ppm_avg, bac, stabil);

  // Kirim ke server
  sendToServer(adc_avg, ppm_avg, bac, stabil);

  // ------------------------------------------------------------
  // Begitu STABIL terdeteksi -> kunci nilai, masuk MODE HOLD
  // Nilai ADC/PPM/BAC tidak berubah selama HOLD_DURATION_MS,
  // tetap ditampilkan & dikirim berulang, lalu reset ke 0.
  // ------------------------------------------------------------
  if (stabil) {
    g_heldAdc = adc_avg;
    g_heldPpm = ppm_avg;
    g_heldBac = bac;
    g_isHolding = true;
    g_holdStart = millis();

    Serial.print(">>> STABIL TERKUNCI selama ");
    Serial.print(HOLD_DURATION_MS / 1000);
    Serial.println(" detik...");
    return;
  }

  // Catatan: buffer TIDAK direset di sini lagi.
  // Buffer kini bersifat sliding window — ppm_buffer terus bergeser
  // (overwrite melingkar via buf_index), sehingga ppm_avg dihitung dari
  // 20 sampel TERBARU setiap loop, bukan dari batch yang dikosongkan ulang.
  // Ini membuat rata-rata lebih halus & status STABIL lebih cepat tercapai
  // saat gas benar-benar sudah landai.
}
